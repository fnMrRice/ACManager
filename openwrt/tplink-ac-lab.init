#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
    local enabled
    config_load tplink_ac
    config_get_bool enabled main enabled 0
    [ "$enabled" = 1 ] || return 0
    procd_open_instance main
    procd_set_param env PYTHONPATH=/opt/tplink-ac-lab/src
    procd_set_param command /usr/bin/python3 -m tplink_ac.host --root /opt/tplink-ac-lab/web --data /opt/tplink-ac-lab/data --uci --start
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param term_timeout 5
    procd_set_param respawn 3600 5 5
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger tplink_ac
}
